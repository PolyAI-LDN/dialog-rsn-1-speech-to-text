# A workspace API key from Agent Studio. Personal access tokens are refused.
DIALOG_API_KEY=
# Base URL. The SDK appends /realtime. Leave unset for api.studio.poly.ai.
# A key from a regional Studio needs that region's host: https://api.us.poly.ai/v1,
# https://api.eu.poly.ai/v1 or https://api.uk.poly.ai/v1
# DIALOGUE_API_URL=https://api.studio.poly.ai/v1
