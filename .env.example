# A workspace API key from Agent Studio. Personal access tokens are refused.
DIALOG_API_KEY=
# Realtime URL. Leave unset for api.studio.poly.ai.
# A key from a regional Studio needs that region's host: wss://api.us.poly.ai/v1/realtime,
# wss://api.eu.poly.ai/v1/realtime or wss://api.uk.poly.ai/v1/realtime
# DIALOG_REALTIME_URL=wss://api.studio.poly.ai/v1/realtime
